# Next.js reads these when the dev server or the Vercel build starts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# The Sanity CLI reads these names. Use the same project id and dataset as above.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=

# Shown in the embedded Studio. The base path must match the folder src/app/sanity-studio.
NEXT_PUBLIC_SANITY_STUDIO_NAME=
NEXT_PUBLIC_SANITY_STUDIO_TITLE=
NEXT_PUBLIC_SANITY_STUDIO_BASE_PATH=
